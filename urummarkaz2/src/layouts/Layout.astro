---
import '../styles/global.css';
import Header from '../components/Header.astro';
import FloatingContact from '../components/FloatingContact.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
  jsonLd?: object;
}

const { title, description, image, keywords, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://urummarkaz.ir').toString();
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
<meta name="google-site-verification" content="MoXlyWTSUci9Ef1rcqMh7OZxAECyprEmWkXDnirEhzg" />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <footer class="bg-slate-800 text-slate-300 py-10 mt-16">
      <div class="max-w-5xl mx-auto px-4 text-center">
        <p class="text-sm">اروم مرکز | مرجع صادرات، واردات و خدمات گمرکی آذربایجان غربی</p>
        <p class="text-xs text-slate-400 mt-2">تلفن: ۰۴۴۳۳۴۶۵۵۲۴ | واتساپ: ۰۹۱۴۳۴۰۳۴۳۱</p>
      </div>
    </footer>
    <FloatingContact />
  </body>
</html>
