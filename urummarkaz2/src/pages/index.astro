---
import Layout from '../layouts/Layout.astro';
import { pages } from '../data/pages';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'اروم مرکز',
  url: 'https://urummarkaz.ir',
  description: 'مرجع صادرات، واردات و خدمات گمرکی آذربایجان غربی',
};

const categoryLabels: Record<string, string> = {
  export: 'صادرات',
  import: 'واردات',
  logistics: 'حمل و نقل',
  consulting: 'مشاوره',
};
const categoryColors: Record<string, string> = {
  export: 'bg-emerald-100 text-emerald-700',
  import: 'bg-blue-100 text-blue-700',
  logistics: 'bg-amber-100 text-amber-700',
  consulting: 'bg-purple-100 text-purple-700',
};
---

<Layout
  title="اروم مرکز | مرجع صادرات، واردات و خدمات گمرکی آذربایجان غربی"
  description="مرجع تخصصی صادرات، واردات و خدمات گمرکی استان آذربایجان غربی. ۳۰ موضوع تخصصی از صادرات سیب ارومیه تا واردات و ترخیص کالا."
  keywords="صادرات ارومیه, واردات ارومیه, گمرک ارومیه, صادرات به عراق, آذربایجان غربی, اروم مرکز"
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="relative h-80 md:h-96 flex items-center overflow-hidden">
    <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=1200&h=600&fit=crop" alt="صادرات و واردات آذربایجان غربی" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-l from-slate-900/95 to-slate-800/60"></div>
    <div class="relative max-w-5xl mx-auto px-4 w-full">
      <h1 class="text-3xl md:text-5xl font-extrabold text-white leading-tight">اروم مرکز</h1>
      <p class="text-lg text-slate-300 mt-3 leading-relaxed max-w-2xl">
        مرجع تخصصی صادرات، واردات و خدمات گمرکی استان آذربایجان غربی. ۳۰ موضوع تخصصی از صادرات سیب ارومیه تا واردات و ترخیص کالا.
      </p>
      <div class="mt-6 flex gap-3">
        <a href="tel:09143403431" class="bg-emerald-500 hover:bg-emerald-400 text-white px-6 py-3 rounded-xl font-bold transition-colors">
          تماس: ۰۹۱۴۳۴۰۳۴۳۱
        </a>
        <a href="https://wa.me/989143403431" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-6 py-3 rounded-xl font-bold transition-colors">
          واتساپ
        </a>
      </div>
    </div>
  </section>

  {/* Services section */}
  <section id="services" class="max-w-5xl mx-auto px-4 py-16">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-800">دسته‌بندی خدمات</h2>
      <p class="text-slate-500 mt-2">صادرات، واردات، حمل و نقل و مشاوره گمرکی</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {Object.entries(categoryLabels).map(([key, label]) => (
        <a href={`#pages`} class="bg-white rounded-2xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <span class={`inline-block text-sm font-bold px-4 py-2 rounded-full ${categoryColors[key]}`}>{label}</span>
        </a>
      ))}
    </div>
  </section>

  {/* All pages */}
  <section id="pages" class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-800">مقالات و خدمات تخصصی</h2>
      <p class="text-slate-500 mt-2">۳۰ موضوع کامل درباره صادرات، واردات و گمرک آذربایجان غربی</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pages.map((page) => (
        <a href={`/${page.slug}`} class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
          <div class="relative h-44 overflow-hidden">
            <img src={page.image} alt={page.imageAlt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <span class={`absolute top-3 right-3 text-xs font-bold px-2 py-1 rounded ${categoryColors[page.category]}`}>
              {categoryLabels[page.category]}
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-bold text-slate-800 leading-snug line-clamp-2 group-hover:text-emerald-600 transition-colors">{page.title}</h3>
            <p class="text-sm text-slate-500 mt-2 line-clamp-2">{page.metaDescription}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* Contact CTA */}
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div id="contact" class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-8 md:p-12 text-center">
      <h2 class="text-2xl font-bold text-white mb-3">تماس با اروم مرکز</h2>
      <p class="text-slate-300 mb-6">برای مشاوره صادرات، واردات و خدمات گمرکی با ما در ارتباط باشید</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="tel:09143403431" class="bg-emerald-500 hover:bg-emerald-400 text-white px-6 py-3 rounded-xl font-bold transition-colors">
          تلفن: ۰۹۱۴۳۴۰۳۴۳۱
        </a>
        <a href="https://wa.me/989143403431" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-6 py-3 rounded-xl font-bold transition-colors">
          واتساپ
        </a>
        <a href="https://instagram.com/vahid.gholipour2026" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-6 py-3 rounded-xl font-bold transition-colors">
          اینستاگرام
        </a>
      </div>
      <p class="text-slate-400 text-sm mt-4">تلفن ثابت: ۰۴۴۳۳۴۶۵۵۲۴</p>
    </div>
  </section>
</Layout>
