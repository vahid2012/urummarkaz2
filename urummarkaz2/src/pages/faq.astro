---
import Layout from '../layouts/Layout.astro';

const faqs = [
  { q: 'صادرات از ارومیه به کدام کشورها انجام می‌شود؟', a: 'عراق با سهم ۷۴ درصدی بزرگ‌ترین بازار است. پس از آن ترکیه، روسیه، کشورهای CIS و حوزه خلیج فارس قرار دارند. مرزهای تمرچین و سرو اصلی‌ترین مسیرهای صادراتی هستند.' },
  { q: 'برای ثبت سفارش واردات چه مدارکی لازم است؟', a: 'کارت بازرگانی فعال، ثبت سفارش در سامانه جامع امور تجاری (NTSW)، گواهی استاندارد یا تأییدیه پزشکی (بسته به نوع کالا)، و ارز برای پرداخت واردات لازم است.' },
  { q: 'گواهی بهداشت گیاهی از کجا دریافت می‌شود؟', a: 'برای محصولات کشاورزی از سازمان حفظ نباتات استان و برای محصولات لبنی از سازمان دامپزشکی استان آذربایجان غربی صادر می‌شود.' },
  { q: 'خدمات تشریفات بازرگانی شامل چه مواردی است؟', a: 'رزرو هتل، ون VIP، رستوران، ترانسفر فرودگاه با پذیرش CIP، رزرو اتاق جلسات، مترجم تجاری و برنامه‌ریزی جلسات B2B با بازرگانان.' },
  { q: 'قیمت محصولات صادراتی چگونه محاسبه می‌شود؟', a: 'قیمت بر اساس کیفیت، گرید، مقدار سفارش، شرایط پرداخت و نوسانات بازار جهانی محاسبه می‌شود. برای استعلام دقیق با واتساپ یا تلفن تماس بگیرید.' },
  { q: 'تورهای تجاری به کدام مقاصد برگزار می‌شود؟', a: 'تورهای تجاری به ترکیه (استانبول و آنکارا)، عراق (بغداد، اربیل، بصره)، جمهوری آذربایجان (باکو) و روسیه برگزار می‌شود. هر تور شامل ویزا، حمل، اقامت و جلسات B2B است.' },
  { q: 'کد گمرکی سیب صادراتی چیست؟', a: 'کد گمرکی سیب درختی صادراتی ۰۸۰۸۱۰ است. برای ثبت سفارش باید این کد در سامانه جامع امور تجاری وارد شود.' },
  { q: 'حمل محصولات فسادپذیر چگونه انجام می‌شود؟', a: 'محصولات فسادپذیر مانند میوه و لبنیات با کامیون یخچال‌دار با دمای کنترل‌شده حمل می‌شوند. دما و زمان حمل برای جلوگیری از فساد ثبت و کنترل می‌شود.' },
  { q: 'چگونه با اروم مرکز همکاری کنم؟', a: 'اگر تولیدکننده، صادرکننده یا واردکننده هستید، با تلفن ۰۹۱۴۳۴۰۳۴۳۱ یا واتساپ تماس بگیرید. کارشناسان ما شرایط همکاری و خدمات قابل ارائه را بررسی می‌کنند.' },
  { q: 'منطقه آزاد ماکو چه مزیت‌هایی برای تجارت دارد؟', a: 'معافیت گمرکی، انبارداری بدون پرداخت عوارض، دسترسی مستقیم به ترکیه و اروپا، و امکان پردازش و بسته‌بندی کالا قبل از صادرات از مزیت‌های اصلی هستند.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="سوالات متداول | اروم مرکز"
  description="پاسخ به سوالات متداول درباره صادرات، واردات، خدمات گمرکی، تشریفات بازرگانی و تورهای تجاری آذربایجان غربی."
  keywords="سوالات متداول, صادرات ارومیه, واردات, خدمات گمرکی, تشریفات بازرگانی, اروم مرکز"
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-4">سوالات متداول</h1>
      <p class="text-slate-300">پاسخ به پرسش‌های رایج درباره صادرات، واردات و خدمات گمرکی</p>
    </div>
  </section>

  <article class="max-w-3xl mx-auto px-4 py-12">
    <div class="space-y-4">
      {faqs.map((faq) => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
          <h2 class="font-bold text-slate-800 mb-2 flex items-start gap-2">
            <span class="text-emerald-500 shrink-0">Q:</span>
            <span>{faq.q}</span>
          </h2>
          <p class="text-slate-600 text-sm leading-relaxed pr-6">{faq.a}</p>
        </div>
      ))}
    </div>

    <section class="bg-slate-800 rounded-2xl p-8 text-center mt-8">
      <h2 class="text-xl font-bold text-white mb-2">سوال دیگری دارید؟</h2>
      <p class="text-slate-300 text-sm mb-6">با کارشناسان اروم مرکز در ارتباط باشید</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="tel:09143403431" class="bg-emerald-500 hover:bg-emerald-400 text-white px-6 py-3 rounded-xl font-bold transition-colors">تماس: ۰۹۱۴۳۴۰۳۴۳۱</a>
        <a href="https://wa.me/989143403431" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-6 py-3 rounded-xl font-bold transition-colors">واتساپ</a>
      </div>
    </section>
  </article>
</Layout>
