---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'همکاری با ما',
  description: 'فرصت‌های همکاری با اروم مرکز در حوزه صادرات، واردات و خدمات گمرکی',
  url: 'https://urummarkaz.ir/cooperation',
};
---

<Layout
  title="همکاری با ما | اروم مرکز"
  description="فرصت‌های همکاری با اروم مرکز در حوزه صادرات، واردات و خدمات گمرکی آذربایجان غربی. صادرکنندگان، واردکنندگان و شرکای تجاری."
  keywords="همکاری با اروم مرکز, شراکت تجاری, صادرات, واردات, آذربایجان غربی"
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-4">همکاری با ما</h1>
      <p class="text-slate-300 leading-relaxed">اروم مرکز با هدف توسعه صادرات و تسهیل امور گمرکی استان آذربایجان غربی، آماده همکاری با صادرکنندگان، واردکنندگان و شرکای تجاری است.</p>
    </div>
  </section>

  <article class="max-w-3xl mx-auto px-4 py-12 space-y-8">
    <section>
      <h2 class="text-xl font-bold text-slate-800 mb-3 border-r-4 border-emerald-500 pr-4">فرصت‌های همکاری</h2>
      <p class="text-slate-600 leading-relaxed">اگر تولیدکننده، صادرکننده یا واردکننده هستید، می‌توانید با اروم مرکز همکاری کنید. ما خدمات گمرکی، حمل و نقل، مشاوره و تشریفات بازرگانی را به‌صورت یکپارچه ارائه می‌دهیم.</p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-800 mb-3 border-r-4 border-emerald-500 pr-4">شرایط همکاری</h2>
      <ul class="space-y-3 text-slate-600">
        <li class="flex items-start gap-2"><span class="text-emerald-500 mt-1">✓</span> دارای کارت بازرگانی فعال</li>
        <li class="flex items-start gap-2"><span class="text-emerald-500 mt-1">✓</span> تولیدکننده یا تأمین‌کننده محصولات صادراتی</li>
        <li class="flex items-start gap-2"><span class="text-emerald-500 mt-1">✓</span> واردکننده با ثبت سفارش معتبر</li>
        <li class="flex items-start gap-2"><span class="text-emerald-500 mt-1">✓</span> شرکت‌های حمل و نقل بین‌المللی</li>
      </ul>
    </section>

    <section class="bg-slate-800 rounded-2xl p-8 text-center">
      <h2 class="text-xl font-bold text-white mb-2">برای شروع همکاری تماس بگیرید</h2>
      <div class="flex flex-wrap gap-3 justify-center mt-4">
        <a href="tel:09143403431" class="bg-emerald-500 hover:bg-emerald-400 text-white px-6 py-3 rounded-xl font-bold transition-colors">تماس: ۰۹۱۴۳۴۰۳۴۳۱</a>
        <a href="https://wa.me/989143403431" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-6 py-3 rounded-xl font-bold transition-colors">واتساپ</a>
      </div>
    </section>
  </article>
</Layout>
