---
import Layout from '../layouts/Layout.astro';

const products = [
  {
    title: 'نمونه سوالات آزمون اخذ کارت بازرگانی (با پاسخنامه)',
    desc: 'بانک کامل سوالات آزمون کارت بازرگانی همراه با پاسخنامه تشریحی.',
    icon: 'clipboard',
  },
  {
    title: 'نمونه سوالات آزمون تأسیس شرکت حمل و نقل بین‌المللی',
    desc: 'سوالات آزمون лиценз شرکت حمل بین‌المللی با پاسخ تشریحی.',
    icon: 'truck',
  },
  {
    title: 'چک‌لیست جامع ترخیص کالا از گمرک بازرگان',
    desc: 'تمام مدارک و مراحل ترخیص از گمرک بازرگان در یک چک‌لیست کاربردی.',
    icon: 'checklist',
  },
  {
    title: 'نمونه قرارداد استاندارد صادرات به ترکیه و عراق',
    desc: 'قالب قرارداد حقوقی صادرات به ترکیه و عراق با تمام بندهای لازم.',
    icon: 'contract',
  },
  {
    title: 'چک‌لیست کامل مدارک و اسناد لازم برای صادرات کالا',
    desc: 'تمام اسناد صادراتی از فاکتور تا گواهی مبدا در یک چک‌لیست.',
    icon: 'documents',
  },
  {
    title: 'نمونه فرم پیش‌فاکتور (Proforma Invoice) صادراتی',
    desc: 'قالب آماده پیش‌فاکتور صادراتی قابل ویرایش با تمام فیلدها.',
    icon: 'invoice',
  },
  {
    title: 'راهنمای گام‌به‌گام ثبت سفارش در سامانه جامع تجارت',
    desc: 'آموزش تصویری ثبت سفارش در سامانه NTSW از صفر تا صد.',
    icon: 'guide',
  },
  {
    title: 'راهنمای اخذ گواهی مبدأ از اتاق بازرگانی',
    desc: 'مراحل و مدارک لازم برای دریافت گواهی مبدا به‌صورت گام‌به‌گام.',
    icon: 'certificate',
  },
  {
    title: 'نمونه قرارداد حمل و نقل بین‌المللی (CMR)',
    desc: 'قالب استاندارد بارنامه CMR برای حمل بین‌المللی کالا.',
    icon: 'cmr',
  },
  {
    title: 'بسته آموزشی صفر تا صد صادرات به عراق و ترکیه',
    desc: 'مجموعه کامل آموزش صادرات به عراق و ترکیه در یک فایل PDF.',
    icon: 'package',
  },
];

const getIcon = (name: string) => {
  const icons: Record<string, string> = {
    clipboard: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 2h6v3H9z"/><path d="M9 12h6M9 16h6"/>',
    truck: '<path d="M5 17h14M5 17a2 2 0 1 1-4 0M19 17a2 2 0 1 1-4 0M3 17V8l2-4h14l2 4v9"/><path d="M3 8h18M8 8V4M16 8V4"/>',
    checklist: '<path d="M9 6h11M9 12h11M9 18h11M5 6l1 1 2-2M5 12l1 1 2-2M5 18l1 1 2-2"/>',
    contract: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6M9 9h1"/>',
    documents: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>',
    invoice: '<path d="M6 2v20l2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1z"/><path d="M9 8h6M9 12h6M9 16h4"/>',
    guide: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
    certificate: '<circle cx="12" cy="8" r="6"/><path d="M15.5 13.5L17 22l-5-3-5 3 1.5-8.5"/><path d="M9 8h6M12 5v6"/>',
    cmr: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 9v12M9 14h6"/>',
    package: '<path d="M16.5 9.4L7.5 4.21M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"/>',
  };
  return icons[name] || icons.clipboard;
};

const waLink = (title: string) =>
  `https://wa.me/989143403431?text=${encodeURIComponent(`سلام، من می‌خواهم فایل ${title} را خریداری کنم.`)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'منابع و فایل‌های آماده تجاری',
  description: 'فایل‌های آماده و چک‌لیست‌های کاربردی برای صادرات، واردات و ترخیص کالا.',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
  })),
};
---

<Layout
  title="منابع و فایل‌های آماده تجاری | اروم مرکز"
  description="دانلود نمونه سوالات آزمون کارت بازرگانی، چک‌لیست ترخیص، قرارداد صادرات، فرم پیش‌فاکتور و راهنمای ثبت سفارش."
  keywords="نمونه سوالات کارت بازرگانی, چک‌لیست ترخیص کالا, قرارداد صادرات, پیش‌فاکتور, ثبت سفارش, گواهی مبدا, CMR, صادرات عراق ترکیه"
  image="https://images.unsplash.com/photo-1457369804619-52f61c5dfa3c?w=1200&h=600&fit=crop"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative h-64 md:h-80 flex items-end overflow-hidden">
    <img
      src="https://images.unsplash.com/photo-1457369804619-52f61c5dfa3c?w=1200&h=600&fit=crop"
      alt="منابع و فایل‌های آماده تجاری"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/95 via-slate-900/60 to-transparent"></div>
    <div class="relative max-w-5xl mx-auto px-4 pb-8 w-full">
      <nav class="text-sm text-slate-400 mb-3">
        <a href="/" class="hover:text-emerald-400">خانه</a>
        <span class="mx-2">/</span>
        <span class="text-slate-200">منابع و فایل‌ها</span>
      </nav>
      <h1 class="text-2xl md:text-4xl font-extrabold text-white">منابع و فایل‌های آماده تجاری</h1>
      <p class="text-slate-300 mt-2 text-sm md:text-base max-w-2xl">
        چک‌لیست‌ها، نمونه قراردادها، فرم‌ها و راهنماهای کاربردی برای صادرات، واردات و ترخیص کالا.
      </p>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((product) => (
        <div class="group bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-lg hover:border-emerald-200 transition-all duration-300 flex flex-col">
          <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center mb-5 group-hover:bg-emerald-500 group-hover:text-white transition-colors duration-300">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(product.icon)} />
          </div>
          <h2 class="font-bold text-slate-800 mb-2 leading-snug text-base">{product.title}</h2>
          <p class="text-sm text-slate-600 leading-relaxed mb-5 flex-grow">{product.desc}</p>
          <a
            href={waLink(product.title)}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-3 rounded-xl font-bold text-sm transition-colors duration-300"
          >
            خرید و دریافت فایل
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Info Banner -->
  <section class="max-w-4xl mx-auto px-4 pb-16">
    <div class="bg-slate-800 rounded-2xl p-8 text-center">
      <h2 class="text-xl font-bold text-white mb-3">سوال یا نیاز به فایل خاص دارید؟</h2>
      <p class="text-slate-300 text-sm mb-6">تماس بگیرید یا در واتساپ پیام بگذارید — تیم اروم مرکز آماده پشتیبانی است.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="tel:09143403431" class="bg-emerald-500 hover:bg-emerald-400 text-white px-6 py-3 rounded-xl font-bold transition-colors">تماس: ۰۹۱۴۳۴۰۳۴۳۱</a>
        <a href="https://wa.me/989143403431" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-6 py-3 rounded-xl font-bold transition-colors">واتساپ</a>
      </div>
    </div>
  </section>
</Layout>
