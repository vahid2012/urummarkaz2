---
import Layout from '../layouts/Layout.astro';
import { pages } from '../data/pages';

export async function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title,
  description: page.metaDescription,
  image: page.image,
  provider: {
    '@type': 'Organization',
    name: 'اروم مرکز',
    telephone: '09143403431',
  },
  areaServed: 'West Azerbaijan, Iran',
  url: `https://urummarkaz.ir/${page.slug}`,
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const categoryLabels: Record<string, string> = {
  export: 'صادرات',
  import: 'واردات',
  logistics: 'حمل و نقل',
  consulting: 'مشاوره',
};
const categoryColors: Record<string, string> = {
  export: 'bg-emerald-100 text-emerald-700',
  import: 'bg-blue-100 text-blue-700',
  logistics: 'bg-amber-100 text-amber-700',
  consulting: 'bg-purple-100 text-purple-700',
};
---

<Layout
  title={page.metaTitle}
  description={page.metaDescription}
  image={page.image}
  keywords={page.keywords}
  jsonLd={[jsonLd, faqLd]}
>
  {/* Hero */}
  <section class="relative h-72 md:h-96 flex items-end overflow-hidden">
    <img src={page.image} alt={page.imageAlt} class="absolute inset-0 w-full h-full object-cover" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-800/50 to-transparent"></div>
    <div class="relative max-w-5xl mx-auto px-4 pb-8 w-full">
      <span class={`inline-block text-xs font-bold px-3 py-1 rounded-full mb-3 ${categoryColors[page.category]}`}>
        {categoryLabels[page.category]}
      </span>
      <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">{page.title}</h1>
      <p class="text-slate-300 text-sm mt-1" dir="ltr">{page.titleEn}</p>
    </div>
  </section>

  {/* Content */}
  <article class="max-w-3xl mx-auto px-4 py-12 space-y-8">
    <p class="text-lg text-slate-700 leading-relaxed">{page.intro}</p>

    {page.sections.map((section) => (
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-slate-800 border-r-4 border-emerald-500 pr-4">{section.heading}</h2>
        <p class="text-slate-600 leading-relaxed">{section.body}</p>
        {section.subsections?.map((sub) => (
          <div class="bg-slate-50 rounded-xl p-5">
            <h3 class="font-bold text-slate-700 mb-2 text-base">{sub.heading}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{sub.body}</p>
          </div>
        ))}
      </section>
    ))}

    {/* FAQ */}
    {page.faqs.length > 0 && (
      <section class="bg-slate-100 rounded-2xl p-6">
        <h2 class="text-xl font-bold text-slate-800 mb-4">سوالات متداول</h2>
        <div class="space-y-4">
          {page.faqs.map((faq) => (
            <div>
              <h3 class="font-bold text-slate-700 text-sm mb-1">{faq.q}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* CTA */}
    <section id="contact" class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-8 text-center">
      <h2 class="text-xl font-bold text-white mb-2">برای مشاوره و استعلام تماس بگیرید</h2>
      <p class="text-slate-300 text-sm mb-6">کارشناسان اروم مرکز آماده پاسخگویی به شما هستند</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="tel:09143403431" class="bg-emerald-500 hover:bg-emerald-400 text-white px-6 py-3 rounded-xl font-bold transition-colors">
          تماس: ۰۹۱۴۳۴۰۳۴۳۱
        </a>
        <a href="https://wa.me/989143403431" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-6 py-3 rounded-xl font-bold transition-colors">
          واتساپ
        </a>
      </div>
    </section>
  </article>
</Layout>
